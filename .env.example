# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Optional: dùng model riêng để chấm RAGAS, giúp tách quota generation/evaluation.
EVALUATOR_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
PAGEINDEX_TIMEOUT_SECONDS=30
PAGEINDEX_REQUEST_TIMEOUT_SECONDS=10

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.55
